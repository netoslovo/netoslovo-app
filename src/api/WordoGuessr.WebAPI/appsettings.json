{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      },
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "UseUtcTimestamp": true
      }
    },
    "OpenTelemetry": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "HostingFeatures": {
    "EmbeddedMigrations": false,
    "OpenApi": false,
    "ForwardedHeaders": false,
    "WolverineDynamicCodeGeneration": false
  },
  "AllowedHosts": "*",
  "ObjectStorage": {
    "S3": {
      "UseHttp": false
    }
  },
  "ApplicationName": "WordoGuessr",
  "Words": {
    "Caching": {
      "CacheSizeLimit": 500,
      "CompactionPercentage": 0.2,
      "Duration": "00:30:00",
      "DistributedDuration": "30.00:00:00"
    }
  },
  "Game": {
    "DbContext": {
      "EnableDebugLogging": false
    },
    "MetricsCollector": {
      "Interval": "00:01:00",
      "ActivePlayerWindow": "00:05:00"
    }
  },
  "Auth": {
    "OtpRateLimit": {
      "RequestLimit": 10,
      "Window": "01:00:00",
      "Cooldown": "00:00:30"
    },
    "UserMetricsCollector": {
      "Interval": "00:01:00"
    }
  },
  "Email": {
    "Sender": {
      "SendingTimeout": "00:00:10",
      "UseSSL": true
    },
    "SendingJob": {
      "Interval": "00:00:05",
      "BatchSize": 20
    },
    "ArchivationJob": {
      "Interval": "00:01:00",
      "BatchSize": 100
    },
    "Queue": {
      "MaxSendingAttempts": 3,
      "SendingHold": "00:05:00",
      "RetryCooldown": "00:00:30",
      "DeduplicationPeriod": "1.00:00:00"
    },
    "QueueMetricsCollector": {
      "Interval": "00:01:00"
    }
  },
  "SchemaMigrator": {
    "EnsureDatabase": false,
    "JournalTable": "schema_migrations_journal"
  }
}

