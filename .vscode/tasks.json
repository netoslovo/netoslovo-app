{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker:debug-services-up",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "wordoguessr-debug",
        "-f",
        "compose.infra.yaml",
        "up",
        "-d",
        "--force-recreate",
        "--wait",
        "--wait-timeout",
        "120"
      ],
      "options": {
        "cwd": "${workspaceFolder}/deployment/docker"
      },
      "problemMatcher": []
    },
    {
      "label": "docker:proxy-host-up",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "wordoguessr-debug",
        "-f",
        "compose.infra.yaml",
        "-f",
        "compose.proxy.host.yaml",
        "up",
        "-d",
        "--force-recreate",
        "--wait",
        "--wait-timeout",
        "120"
      ],
      "options": {
        "cwd": "${workspaceFolder}/deployment/docker"
      },
      "problemMatcher": []
    },
    {
      "label": "docker:migration-services-up",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "wordoguessr-debug",
        "-f",
        "compose.infra.yaml",
        "up",
        "-d",
        "--force-recreate",
        "--wait",
        "--wait-timeout",
        "120",
        "postgres",
        "otel-collector",
        "victoriametrics",
        "victorialogs",
        "grafana"
      ],
      "options": {
        "cwd": "${workspaceFolder}/deployment/docker"
      },
      "problemMatcher": []
    },
    {
      "label": "docker:debug-stack-down",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "wordoguessr-debug",
        "-f",
        "compose.infra.yaml",
        "-f",
        "compose.proxy.host.yaml",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}/deployment/docker"
      },
      "problemMatcher": []
    },
    {
      "label": "docker:debug-stack-down-with-data",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "wordoguessr-debug",
        "-f",
        "compose.infra.yaml",
        "-f",
        "compose.proxy.host.yaml",
        "down",
        "--volumes",
        "--remove-orphans"
      ],
      "options": {
        "cwd": "${workspaceFolder}/deployment/docker"
      },
      "problemMatcher": []
    },
    {
      "label": "build:webapi",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "src/api/WordoGuessr.WebAPI/WordoGuessr.WebAPI.csproj"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api:prepare-debug",
      "dependsOrder": "sequence",
      "dependsOn": ["build:webapi", "docker:debug-services-up"],
      "problemMatcher": []
    },
    {
      "label": "api:prepare-debug-host-mode",
      "dependsOrder": "sequence",
      "dependsOn": ["build:webapi", "docker:proxy-host-up"],
      "problemMatcher": []
    },
    {
      "label": "api:prepare-debug-migration-mode",
      "dependsOrder": "sequence",
      "dependsOn": ["build:webapi", "docker:migration-services-up"],
      "problemMatcher": []
    },
    {
      "label": "docker:proxy-cloudpub-up",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "wordoguessr-debug",
        "-f",
        "compose.infra.yaml",
        "-f",
        "compose.proxy.cloudpub.yaml",
        "up",
        "-d",
        "--force-recreate",
        "--wait",
        "--wait-timeout",
        "120"
      ],
      "options": {
        "cwd": "${workspaceFolder}/deployment/docker"
      },
      "problemMatcher": []
    },
    {
      "label": "docker:debug-cloudpub-stack-down",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "wordoguessr-debug",
        "-f",
        "compose.infra.yaml",
        "-f",
        "compose.proxy.cloudpub.yaml",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}/deployment/docker"
      },
      "problemMatcher": []
    },
    {
      "label": "api:prepare-debug-cloudpub",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build:webapi",
        "docker:proxy-cloudpub-up"
      ],
      "problemMatcher": []
    }
  ]
}
