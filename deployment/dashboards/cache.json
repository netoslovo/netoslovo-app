    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "Share of high-level cache lookups served from either cache level in the selected time range.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 3},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(increase({__name__=\"fusioncache.cache.hit\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__range])) / clamp_min(sum(increase({__name__=~\"fusioncache.cache.(hit|miss)\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__range])), 1e-9)", "instant": true, "legendFormat": "Hit ratio", "refId": "A"}],
      "title": "Overall hit ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "Share of memory-level lookups served by the in-process cache in the selected time range.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 3},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(increase({__name__=\"fusioncache.memory.hit\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__range])) / clamp_min(sum(increase({__name__=~\"fusioncache.memory.(hit|miss)\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__range])), 1e-9)", "instant": true, "legendFormat": "L1 hit ratio", "refId": "A"}],
      "title": "Memory hit ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "Share of distributed-cache lookups served by Valkey after an L1 miss in the selected time range.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 3},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(increase({__name__=\"fusioncache.distributed.hit\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__range])) / clamp_min(sum(increase({__name__=~\"fusioncache.distributed.(hit|miss)\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__range])), 1e-9)", "instant": true, "legendFormat": "L2 hit ratio", "refId": "A"}],
      "title": "Distributed hit ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "Factory, serialization, and deserialization failures in the selected range.",
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "short"}},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 3},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(increase({__name__=~\"fusioncache.(factory.error|serialize_error|deserialize_error)\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__range]))", "instant": true, "legendFormat": "Failures", "refId": "A"}],
      "title": "Cache failures",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "High-level FusionCache hit and miss rates.",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 5,
      "targets": [
        {"expr": "sum(rate({__name__=\"fusioncache.cache.hit\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "hit", "refId": "A"},
        {"expr": "sum(rate({__name__=\"fusioncache.cache.miss\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "miss", "refId": "B"}
      ],
      "title": "Overall lookup outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "L1 lookup outcomes by application instance.",
      "fieldConfig": {"defaults": {"unit": "ops"}},
