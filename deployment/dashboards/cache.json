      "id": 6,
      "targets": [
        {"expr": "sum by (service\\.instance\\.id) (rate({__name__=\"fusioncache.memory.hit\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "{{service.instance.id}} hit", "refId": "A"},
        {"expr": "sum by (service\\.instance\\.id) (rate({__name__=\"fusioncache.memory.miss\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "{{service.instance.id}} miss", "refId": "B"}
      ],
      "title": "Memory lookup outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "L2 Valkey lookup outcomes after memory misses.",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 7,
      "targets": [
        {"expr": "sum(rate({__name__=\"fusioncache.distributed.hit\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "hit", "refId": "A"},
        {"expr": "sum(rate({__name__=\"fusioncache.distributed.miss\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "miss", "refId": "B"}
      ],
      "title": "Distributed lookup outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "Successful, failed, and timed-out value factories.",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 8,
      "targets": [
        {"expr": "sum(rate({__name__=\"fusioncache.factory.success\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "success", "refId": "A"},
        {"expr": "sum(rate({__name__=\"fusioncache.factory.error\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "error", "refId": "B"},
        {"expr": "sum(rate({__name__=\"fusioncache.factory.synthetic_timeout\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "synthetic timeout", "refId": "C"}
      ],
      "title": "Factory outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "High-level cache operations split by the bounded words-version tag.",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 9,
      "targets": [{"expr": "sum by (fusioncache\\.operation\\.tag) (rate({__name__=\"fusioncache.cache.get_or_set\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\", fusioncache\\.operation\\.tag=~\"${cache_tag:regex}\"}[$__rate_interval]))", "legendFormat": "{{fusioncache.operation.tag}}", "refId": "A"}],
      "title": "Get-or-set rate by cache tag",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "Memory evictions grouped by the FusionCache eviction reason.",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 10,
      "targets": [{"expr": "sum by (fusioncache\\.memory\\.evict_reason) (rate({__name__=\"fusioncache.memory.evict\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "{{fusioncache.memory.evict_reason}}", "refId": "A"}],
      "title": "Memory evictions by reason",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "Memory and distributed cache reads, writes, removals, expirations, and evictions.",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "id": 11,
      "targets": [
        {"expr": "sum by (__name__) (rate({__name__=~\"fusioncache.memory.(get|set|remove|expire|evict)\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "{{__name__}}", "refId": "A"},
        {"expr": "sum by (__name__) (rate({__name__=~\"fusioncache.distributed.(get|set|remove)\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "{{__name__}}", "refId": "B"}
      ],
      "title": "Low-level operation rates",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "description": "Resilience and data-format events that should normally remain near zero, except eager refresh.",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "id": 12,
      "targets": [{"expr": "sum by (__name__) (rate({__name__=~\"fusioncache.(failsafe_activate|eager_refresh|serialize_error|deserialize_error|distributed.circuit_breaker_change)\", service\\.name=\"WordoGuessr.WebAPI\", service\\.instance\\.id=~\"${instance:regex}\"}[$__rate_interval]))", "legendFormat": "{{__name__}}", "refId": "A"}],
      "title": "Resilience and error events",
      "type": "timeseries"
    }
  ],
